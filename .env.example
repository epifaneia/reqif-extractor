# Copia este fichero a .env y rellena la clave.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.1-pro-preview)
# GEMINI_MODEL=gemini-3.1-pro-preview

# --- v5: enrutado por regiones (defaults sensatos; ver config.py) ---
# Modelos de las rutas BARATAS (tablas gmft, crops, rescate). flash-lite =
# misma tarea, fracción del precio ($0.25/$1.50 por M, jul-2026); si devuelve
# no-JSON el router escala a pro solo. Pinear versión, nada de -latest.
# REQIF_TABLE_MODEL=gemini-3.1-flash-lite
# REQIF_CROP_MODEL=gemini-3.1-flash-lite
# Backend de visión para crops: gemini (default) | local (vLLM/SGLang)
# REQIF_VLM_BACKEND=gemini
# REQIF_VLM_LOCAL_URL=http://localhost:8000/v1
# REQIF_VLM_LOCAL_MODEL=zai-org/GLM-OCR
# Red de seguridad: fallback a visión de PDF completo si hay IDs huérfanos (1=on)
# REQIF_FALLBACK_FULLPAGE=1
# Docs "clase invisible" (IDs con fuente sin ToUnicode, solo visión los ve):
# fallback forzado por substring de nombre, separados por coma
# REQIF_FORCE_FALLBACK_STEMS=DOC_A,DOC_B

# --- custodia: los tres cables de integracion (docs/INTEGRATION.md) ---
# CUSTODIA_ACTOR=ana.garcia            # obligatorio: el pipeline no corre sin actor
# CUSTODIA_LEDGER=logs/custody.jsonl   # libro de custodia (o - para stdout)
# CUSTODIA_SIGNING_KEY=                # clave local de firma; la empresa la sustituye por su PKI
