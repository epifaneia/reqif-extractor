<?xml version='1.0' encoding='utf-8'?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="{{PFX}}HDR-001">
      <COMMENT>Generated by Loop APIs v10</COMMENT>
      <CREATION-TIME>{{NOW}}</CREATION-TIME>
      <REQ-IF-TOOL-ID>Loop APIs v10</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>Loop APIs v10</SOURCE-TOOL-ID>
      <TITLE>{{TITLE}}</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="polarion_type_string" LAST-CHANGE="{{NOW}}" LONG-NAME="String (single line plain text)" MAX-LENGTH="999999999" />
      <DATATYPE-DEFINITION-XHTML IDENTIFIER="polarion_type_rich_text" LAST-CHANGE="{{NOW}}" LONG-NAME="Rich Text (multi-line)" /></DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT-Heading" LAST-CHANGE="{{NOW}}" LONG-NAME="Info">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-HeadingTitle" LAST-CHANGE="{{NOW}}" LONG-NAME="ReqIF.ChapterName" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-HeadingNumber" LAST-CHANGE="{{NOW}}" LONG-NAME="ReqIF.ChapterNumber" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-HeadingLevel" LAST-CHANGE="{{NOW}}" LONG-NAME="Level" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT-Requirement" LAST-CHANGE="{{NOW}}" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-FullID" LAST-CHANGE="{{NOW}}" LONG-NAME="Full ID" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-ReqID" LAST-CHANGE="{{NOW}}" LONG-NAME="ReqIF.ForeignID" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="AD-Text" LAST-CHANGE="{{NOW}}" LONG-NAME="ReqIF.Text" IS-EDITABLE="true"><TYPE><DATATYPE-DEFINITION-XHTML-REF>polarion_type_rich_text</DATATYPE-DEFINITION-XHTML-REF></TYPE></ATTRIBUTE-DEFINITION-XHTML><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-Section" LAST-CHANGE="{{NOW}}" LONG-NAME="ReqIF.ChapterNumber" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-Source" LAST-CHANGE="{{NOW}}" LONG-NAME="Source File" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-Coverage" LAST-CHANGE="{{NOW}}" LONG-NAME="Coverage" IS-EDITABLE="true">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>polarion_type_string</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="polarion_live_document" LAST-CHANGE="{{NOW}}" LONG-NAME="Polarion Live Document" />
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        {{SPEC_OBJECTS}}
      </SPEC-OBJECTS>
      <SPEC-RELATIONS />
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="{{PFX}}SPEC-001" LAST-CHANGE="{{NOW}}" LONG-NAME="{{TITLE}}">
          <TYPE>
            <SPECIFICATION-TYPE-REF>polarion_live_document</SPECIFICATION-TYPE-REF>
          </TYPE>
          <CHILDREN>
            {{HIERARCHY}}
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
  <TOOL-EXTENSIONS />
</REQ-IF>